[Unit]
Description=btcedu - Mirror the free-photo collection from Wikimedia Commons
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pi
WorkingDirectory=/home/pi/AI-Startup-Lab/bitcoin-education
ExecStart=/home/pi/AI-Startup-Lab/bitcoin-education/.venv/bin/btcedu media-sync
EnvironmentFile=/home/pi/AI-Startup-Lab/bitcoin-education/.env
Nice=10
StandardOutput=journal
StandardError=journal
