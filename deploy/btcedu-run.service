[Unit]
Description=btcedu - Detect + process the newest pending tagesschau 20:00 Uhr episode
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pi
WorkingDirectory=/home/pi/AI-Startup-Lab/bitcoin-education
ExecStart=/home/pi/AI-Startup-Lab/bitcoin-education/.venv/bin/btcedu run-latest --profile tagesschau_tr --all-channels
EnvironmentFile=/home/pi/AI-Startup-Lab/bitcoin-education/.env
StandardOutput=journal
StandardError=journal
# A full tagesschau pipeline (translate + render on the Pi) can take well over
# 30 min, so allow up to 2 hours before systemd considers the run hung.
TimeoutStartSec=7200
# The Pi has 4 cores and an armed hardware watchdog (RuntimeWatchdogSec=1m in
# /usr/lib/systemd/system.conf.d/40-rpi-enable-watchdog.conf). A software-encoded
# ffmpeg render saturated all cores, starved PID 1 for over a minute and the
# watchdog hard-reset the board mid-render (see the orphaned RENDER/RUNNING rows
# in pipeline_runs). Capping the job at 3 of 4 cores keeps systemd schedulable.
CPUQuota=300%
CPUWeight=20
IOWeight=20
Nice=10
