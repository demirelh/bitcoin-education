# Budgetfreigabe für almanya24-daily.service
#
# Kopieren nach data/almanya24-preview/daily-budget.env (nicht versioniert).
# Ohne diese Datei bleiben kostenpflichtige Aufrufe gesperrt.
#
# Alle drei Grenzen gelten je Kalendertag in Europe/Berlin und werden vor
# jedem Anbieteraufruf geprüft. Verworfene Antworten und Retries zählen mit.

ALMANYA24_DAILY_BUDGET_USD=0.00
ALMANYA24_DAILY_MAX_CALLS=0
ALMANYA24_DAILY_MAX_STORIES=0
