# Required API Keys
ANTHROPIC_API_KEY=sk-ant-xxx
OPENAI_API_KEY=sk-xxx
WHISPER_API_KEY=  # falls back to OPENAI_API_KEY if empty

# Podcast Source
SOURCE_TYPE=youtube_rss
PODCAST_YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxx
# PODCAST_RSS_URL=https://custom.feed/rss  # override if source_type=rss

# Database (default: SQLite in data/)
DATABASE_URL=sqlite:///data/btcedu.db

# Raw data storage
RAW_DATA_DIR=data/raw

# Transcription
TRANSCRIPTS_DIR=data/transcripts
WHISPER_MODEL=whisper-1
WHISPER_LANGUAGE=de
TRANSCRIPTION_PRIMARY_PROVIDER=openai
# Empty keeps WHISPER_MODEL as the primary model.
TRANSCRIPTION_PRIMARY_MODEL=
TRANSCRIPTION_SECONDARY_ENABLED=false
TRANSCRIPTION_SECONDARY_PROVIDER=openai
TRANSCRIPTION_SECONDARY_MODEL=
TRANSCRIPTION_SECONDARY_MODE=suspicious_segments_only
TRANSCRIPTION_MAX_SECONDARY_AUDIO_SECONDS=300
TRANSCRIPTION_MAX_SECONDARY_CLIPS=10
TRANSCRIPTION_SUSPICIOUS_SEGMENT_CONTEXT_SECONDS=15
TRANSCRIPTION_OPENAI_COST_PER_MINUTE_USD=0.006
TRANSCRIPT_QA_ENABLED=true
TRANSCRIPT_QA_BLOCK_ON_CRITICAL=true
TRANSCRIPT_QA_MAX_MAJOR_FINDINGS=3
TRANSCRIPT_QA_AUTO_CONTINUE_BELOW_THRESHOLD=true

# Chunking
CHUNKS_DIR=data/chunks
CHUNK_SIZE=1500
CHUNK_OVERLAP=0.15

# Audio
AUDIO_FORMAT=m4a

# Content Generation
LLM_PROVIDER=anthropic
CLAUDE_MODEL=claude-sonnet-4-20250514
OPENAI_LLM_MODEL=gpt-4o
GITHUB_TOKEN=
GITHUB_MODELS_MODEL=openai/gpt-4.1
COPILOT_CLI_MODEL=claude-sonnet-5
COPILOT_CLI_BINARY=copilot
COPILOT_CLI_TIMEOUT=900
QA_REVIEW_ENABLED=true
QA_MODEL=gpt-5.6-sol
CLAUDE_MAX_TOKENS=4096
CLAUDE_TEMPERATURE=0.3
DRY_RUN=false

# TTS / ElevenLabs (Sprint 8)
ELEVENLABS_API_KEY=
# Optionale Reservekonten, kommagetrennt. Werden erst benutzt, wenn das
# Kontingent des vorherigen Kontos aufgebraucht ist (HTTP 401 quota_exceeded).
ELEVENLABS_API_KEY_FALLBACK=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY_BOOST=0.75
ELEVENLABS_STYLE=0.0
ELEVENLABS_USE_SPEAKER_BOOST=true

# Talking avatar (disabled by default; provider/engine may be profile-owned)
ANCHOR_ENABLED=false
ANCHOR_PROVIDER=d-id
ANCHOR_MAX_COST_USD=15.0
DID_API_KEY=
DID_SOURCE_IMAGE_PATH=data/anchor/default.png
DID_SOURCE_IMAGE_URL=
DID_COST_PER_SECOND_USD=0.015
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_ENGINE=avatar_iv
HEYGEN_AVATAR_TYPE=digital_twin
# The service supports webm alpha, but the current renderer is opaque-only.
HEYGEN_OUTPUT_FORMAT=mp4
HEYGEN_RESOLUTION=1080p
HEYGEN_ASPECT_RATIO=auto

# Render / ffmpeg (Sprint 9-10)
# Raspberry Pi production recommendation: RENDER_PRESET=ultrafast and
# RENDER_TIMEOUT_SEGMENT=900. The values below are generic defaults.
RENDER_RESOLUTION=1920x1080
RENDER_FPS=25
RENDER_CRF=23
RENDER_PRESET=medium
RENDER_AUDIO_BITRATE=192k
RENDER_FONT=NotoSans-Bold
RENDER_TIMEOUT_SEGMENT=300
RENDER_TIMEOUT_CONCAT=600
RENDER_TRANSITION_DURATION=0.5

# Remote render (offload ffmpeg to a GitHub Actions runner)
# The Pi needs ~47 min per bulletin and saturates all cores doing it; a hosted
# runner is roughly 2.5x faster. The dashboard switch overrides this value at
# runtime. Requires GITHUB_TOKEN with 'repo' and 'workflow' scope.
RENDER_EXECUTION_MODE=github
# GITHUB_RENDER_REPO=owner/repo   # default: derived from the origin remote
GITHUB_RENDER_WORKFLOW=render.yml
GITHUB_RENDER_TIMEOUT=5400
GITHUB_RENDER_POLL_INTERVAL=20
GITHUB_RENDER_FALLBACK_LOCAL=true

# Image Generation (Sprint 7)
IMAGE_GEN_PROVIDER=dalle3
IMAGE_GEN_MODEL=dall-e-3
IMAGE_GEN_SIZE=1792x1024
IMAGE_GEN_QUALITY=standard
FAL_API_KEY=
IDEOGRAM_API_KEY=
# IMAGE_GEN_STYLE_PREFIX=  # Prepended to all image prompts (long default in config.py)

# YouTube Publishing
# Test and production use different OAuth files and expected channel IDs.
# Channel IDs and paths are not secrets; the JSON files themselves must never
# be committed. Publishing fails before upload when the selected channel ID is
# blank or does not match the authenticated account.
YOUTUBE_DEFAULT_TARGET=test
YOUTUBE_TEST_CLIENT_SECRETS_PATH=data/youtube/test/client_secret.json
YOUTUBE_TEST_CREDENTIALS_PATH=data/youtube/test/credentials.json
YOUTUBE_TEST_CHANNEL_ID=
YOUTUBE_TEST_DEFAULT_PRIVACY=private
YOUTUBE_PRODUCTION_CLIENT_SECRETS_PATH=data/youtube/production/client_secret.json
YOUTUBE_PRODUCTION_CREDENTIALS_PATH=data/youtube/production/credentials.json
YOUTUBE_PRODUCTION_CHANNEL_ID=
YOUTUBE_PRODUCTION_DEFAULT_PRIVACY=unlisted
YOUTUBE_UPLOAD_CHUNK_SIZE_MB=10
YOUTUBE_CATEGORY_ID=27
YOUTUBE_DEFAULT_LANGUAGE=tr

# Primary/secondary failover coordination (disabled by default)
FAILOVER_ENABLED=false
FAILOVER_NODE_ID=btcedu-primary
FAILOVER_NODE_ROLE=primary
FAILOVER_CONTROL_PLANE_URL=http://127.0.0.1:8092
# Either set the token directly or point to a file containing only the token.
FAILOVER_TOKEN=
FAILOVER_TOKEN_FILE=
# Optional, for the dashboard's central mode switch:
FAILOVER_OPERATOR_TOKEN=
FAILOVER_OPERATOR_TOKEN_FILE=
FAILOVER_REQUEST_TIMEOUT_SECONDS=5
FAILOVER_HEARTBEAT_INTERVAL_SECONDS=60
FAILOVER_PIPELINE_LEASE_TTL_SECONDS=540
FAILOVER_PIPELINE_LEASE_RENEW_INTERVAL_SECONDS=120
FAILOVER_PUBLISH_LEASE_TTL_SECONDS=900

# Pipeline Settings
PIPELINE_VERSION=2
DEFAULT_CONTENT_PROFILE=bitcoin_podcast
MAX_EPISODE_COST_USD=10.0
MAX_RETRIES=3

# Output
OUTPUTS_DIR=data/outputs

# Reports & Logs
REPORTS_DIR=data/reports
LOGS_DIR=data/logs

# WhatsApp notifications (see /home/pi/services/whatsapp-service)
NOTIFY_WHATSAPP_ENABLED=false
NOTIFY_WHATSAPP_URL=http://127.0.0.1:3010
NOTIFY_WHATSAPP_TOKEN=
NOTIFY_WHATSAPP_TIMEOUT=15
# NOTIFY_WHATSAPP_NUMBER=  # optional override, otherwise the service default is used
