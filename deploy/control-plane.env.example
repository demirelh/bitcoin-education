# External failover control-plane environment
# Copy to /etc/btcedu-control-plane.env (or another secure EnvironmentFile path).

FAILOVER_CONTROL_PLANE_DATABASE_PATH=/var/lib/btcedu-control-plane/control_plane.db
FAILOVER_CONTROL_PLANE_OPERATOR_TOKEN_FILE=/etc/btcedu-control-plane/operator.token
FAILOVER_CONTROL_PLANE_NODE_TOKENS_FILE=/etc/btcedu-control-plane/node_tokens.json
FAILOVER_CONTROL_PLANE_HEARTBEAT_STALE_SECONDS=180
FAILOVER_CONTROL_PLANE_TAKEOVER_GRACE_SECONDS=420
FAILOVER_CONTROL_PLANE_STABLE_PRIMARY_RECOVERY_SECONDS=300

