[Unit]
Description=btcedu - Detect + process the newest pending tagesschau 20:00 Uhr episode
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pi
WorkingDirectory=/home/pi/AI-Startup-Lab/bitcoin-education
ExecStart=/home/pi/AI-Startup-Lab/bitcoin-education/.venv/bin/btcedu run-latest --profile tagesschau_tr --all-channels
EnvironmentFile=/home/pi/AI-Startup-Lab/bitcoin-education/.env
StandardOutput=journal
StandardError=journal
# A full tagesschau pipeline (translate + render on the Pi) can take well over
# 30 min, so allow up to 2 hours before systemd considers the run hung.
TimeoutStartSec=7200
